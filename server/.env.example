# Backend runtime
NODE_ENV=development
PORT=4000

# PostgreSQL 17
DB_HOST=localhost
DB_PORT=5433
DB_NAME=quadpro_ecom
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgres-password
DB_SSL=false
DB_POOL_MAX=10
DB_ADMIN_DATABASE=postgres

# Optional alternative to the discrete DB_* settings
# DATABASE_URL=

# Legacy JSON source read only by db:init
DATA_FILE=./data/store.json

# Neon Managed Better Auth (use the Auth URL, not the JWKS URL)
NEON_AUTH_BASE_URL=https://your-neon-auth-host/neondb/auth

# Stripe Test mode (never expose these values through VITE_ variables)
STRIPE_SECRET_KEY=sk_test_replace_with_your_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret
APP_BASE_URL=http://localhost:5173

# VNPay Sandbox merchant credentials
VNPAY_TMN_CODE=replace_with_your_terminal_code
VNPAY_HASH_SECRET=replace_with_your_hash_secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
