# Backend runtime
NODE_ENV=development
PORT=4000

# PostgreSQL 17
DB_HOST=localhost
DB_PORT=5433
DB_NAME=quadpro_ecom
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgres-password
DB_SSL=false
DB_POOL_MAX=10
DB_ADMIN_DATABASE=postgres

# Optional alternative to the discrete DB_* settings
# DATABASE_URL=

# Legacy JSON source read only by db:init
DATA_FILE=./data/store.json

# Authentication
JWT_SECRET=replace-this-with-a-long-random-production-secret

# Seed administrator (used when the data store is first created)
ADMIN_EMAIL=admin@quadpro.vn
ADMIN_PASSWORD=replace-with-a-strong-admin-password
